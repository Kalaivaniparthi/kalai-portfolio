# Gmail account that sends the email
EMAIL_USER=your.email@gmail.com
# Gmail App Password (Google Account > Security > 2-Step Verification > App passwords)
EMAIL_PASS=xxxx xxxx xxxx xxxx
# Inbox that receives messages (defaults to EMAIL_USER)
EMAIL_TO=

# Extra comma-separated CORS origins (localhost:3000 is always allowed)
ALLOWED_ORIGINS=https://your-portfolio.vercel.app
# Regex for additional origins (Vercel preview deployments by default)
ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app

# Optional
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
RATE_LIMIT=5
RATE_WINDOW_SECONDS=600
